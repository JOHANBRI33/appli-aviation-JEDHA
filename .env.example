# Copiez ce fichier en .env.local et remplissez les valeurs.
# Ne commitez jamais .env.local — il contient vos clés secrètes.

# Variables publiques (exposées au navigateur, préfixe NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Variables serveur uniquement (jamais exposées au navigateur)
SUPABASE_SERVICE_ROLE_KEY=
VISION_API_KEY=
